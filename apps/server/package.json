{
  "name": "@autologger/server",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=../../.env src/main.ts",
    "start": "node src/main.ts",
    "worker": "node src/worker/main.ts",
    "dev:worker": "node --watch --env-file-if-exists=../../.env src/worker/main.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=../../.env src/db/migrate.ts",
    "typecheck": "tsc -p .",
    "test": "vitest run",
    "test:deepgram": "DEEPGRAM_LIVE_TEST=1 vitest run src/media/deepgram.live.test.ts"
  },
  "dependencies": {
    "@autologger/contract": "*",
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "@hono/node-server": "^1.19.0",
    "@modelcontextprotocol/sdk": "^1.32.0",
    "arctic": "^3.7.0",
    "drizzle-orm": "^0.45.0",
    "hono": "^4.10.0",
    "postgres": "^3.4.7",
    "ws": "^8.18.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/ws": "^8.18.0",
    "drizzle-kit": "^0.31.0"
  }
}
