# Copy to .env for local development (npm run dev:server / dev:web).
DATABASE_URL=postgres://autologger:autologger@localhost:54329/autologger
PUBLIC_URL=http://localhost:5173
PORT=18081

# Humans: Google OAuth (redirect URI: $PUBLIC_URL/auth/google/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Dev-only email login (never in production)
DEV_LOGIN=1
# Public landing page for signed-out visitors at / (0 sends them straight to sign-in)
LANDING_PAGE=1
# Base URL of your own copy of docs/ for the landing page's doc links, e.g.
# https://git.example.com/you/autologger/src/branch/main/docs (unset: the upstream GitHub docs)
DOCS_URL=
# Comma-separated emails that become active superadmins on first sign-in
SUPERADMIN_EMAILS=

# Media storage (SeaweedFS in compose)
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=autologger
S3_ACCESS_KEY_ID=autologger
S3_SECRET_ACCESS_KEY=autologger-secret
S3_FORCE_PATH_STYLE=1

# Transcription
DEEPGRAM_API_KEY=

# YouTube import (needs yt-dlp + ffmpeg on PATH of the worker)
YOUTUBE_IMPORT=1
YTDLP_PATH=yt-dlp
# If YouTube answers "Sign in to confirm you're not a bot" (common on servers): cookies.txt of a
# signed-in throwaway account (copied per run, may be read-only) and/or a proxy. docs/media.md.
# YTDLP_COOKIES_FILE=/run/secrets/youtube-cookies.txt
# YTDLP_PROXY=socks5://user:pass@proxy.example.com:1080
# YTDLP_EXTRA_ARGS=--extractor-args youtube:player_client=web

# Worker: jobs run in parallel per worker, and optional per-kind caps within that
# (default: the total). A YouTube import cap of 1 keeps a slot free for transcriptions.
WORKER_CONCURRENCY=2
# WORKER_CONCURRENCY_TRANSCRIBE=2
# WORKER_CONCURRENCY_YOUTUBE_IMPORT=1
# WORKER_CONCURRENCY_WAVEFORM=1
# WORKER_CONCURRENCY_COMPILE=1
# Waveform peaks for the timeline (ffmpeg on the worker; jobs are skipped without it)
# FFMPEG_PATH=ffmpeg
